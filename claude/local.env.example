# Machine-local values. Copy to local.env (gitignored). Sourced by hooks and scripts.
# Each line keeps an already-exported environment variable if one is set.
MACHINE_NAME="${MACHINE_NAME:-$(hostname -s)}"      # name used for .learnings/inbox/<machine>.md
LEARN_SYNC_ON_START="${LEARN_SYNC_ON_START:-1}"     # 1: git pull dotfiles on session start (quiet, never blocks)
ORCH_EVENT_LOG="${ORCH_EVENT_LOG:-$HOME/.claude/orch-events.jsonl}"
# Front-stage and orchestrator session models (orch-start.sh)
ORCH_FRONT_MODEL="${ORCH_FRONT_MODEL:-opus}"
ORCH_PM_MODEL="${ORCH_PM_MODEL:-sonnet}"
ORCH_ORCH_MODEL="${ORCH_ORCH_MODEL:-sonnet}"
# QA capabilities on this machine (the qa agent reads these)
QA_WEB="${QA_WEB:-1}"
QA_IOS="${QA_IOS:-0}"        # 1 when Xcode + simulator are installed
QA_ANDROID="${QA_ANDROID:-0}"    # 1 when an emulator is available
